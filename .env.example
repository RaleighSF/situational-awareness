# Cosmos VLM endpoint (already deployed)
COSMOS_ENDPOINT=https://cosmos.agentdemos.com

# Gemini API (replaces OpenAI for counting classification + RAG synthesis)
GEMINI_API_KEY=your-gemini-api-key-here

# PostgreSQL (for Cosmos-Watcher Express backend)
DATABASE_URL=postgresql://user:password@localhost:5432/cosmos_watcher

# VSS API Backend (FastAPI)
VSS_API_PORT=8200
VSS_API_HOST=0.0.0.0

# Caption indexer settings
CAPTION_RATE_SECONDS=10
CAPTION_BATCH_SIZE=4

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data
