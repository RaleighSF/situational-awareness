[Unit]
Description=VSS API Gateway (FastAPI)
After=network.target cosmos-api.service
Wants=cosmos-api.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/vss/backend
Environment=PATH=/home/ubuntu/vss/backend/.venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/ubuntu/vss/.env
ExecStart=/home/ubuntu/vss/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8200
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
